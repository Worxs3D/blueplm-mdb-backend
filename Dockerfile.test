FROM php:8.3-apache

RUN docker-php-ext-install pdo_mysql \
    && a2enmod rewrite \
    && sed -ri 's!/var/www/html!/app/public!g' /etc/apache2/sites-available/000-default.conf \
    && printf '<Directory /app/public>\n    Options -Indexes +FollowSymLinks\n    AllowOverride All\n    Require all granted\n</Directory>\n' > /etc/apache2/conf-available/blueplm.conf \
    && a2enconf blueplm

WORKDIR /app
COPY . /app
RUN chown -R www-data:www-data /app

CMD ["sh", "-c", "cp /app/test/install-env.fixture /app/.env.install && chown www-data:www-data /app/.env.install && exec apache2-foreground"]
