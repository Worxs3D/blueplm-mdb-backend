# Store this file one directory above public/ on the webspace. Never publish it.
BLUEPLM_ENV=production
# Electron production builds load from file:// and Chromium sends Origin: null.
# Keep localhost only for local Vite development; use HTTPS origins for web clients.
BLUEPLM_CORS_ORIGINS=null,file://,http://localhost:5173
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DATABASE=blueplm
MARIADB_USER=
MARIADB_PASSWORD=
BLUEPLM_SESSION_SECRET=
# Generate all three values with: node scripts/generate-secrets.mjs
# Used only by /setup/ and /auth/bootstrap. Remove it after initial setup.
BLUEPLM_BOOTSTRAP_TOKEN=
# Used by the deployment adapter to run schema migrations. Keep private.
BLUEPLM_MAINTENANCE_TOKEN=
# Public HTTPS URL of this PHP installation. Used by deployment verification.
BLUEPLM_PUBLIC_URL=https://blueplm.example.tld
BLUEPLM_CHECKOUT_TTL_MINUTES=480
